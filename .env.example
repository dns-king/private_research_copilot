PRC_ENV=local
PRC_LOG_LEVEL=INFO
PRC_DATABASE_PATH=data/research_copilot.db
PRC_UPLOAD_DIR=data/uploads
PRC_EXPORT_DIR=data/exports
PRC_OLLAMA_BASE_URL=http://localhost:11434
PRC_CHAT_MODELS=llama3,mistral,gemma,deepseek-r1,phi3
PRC_DEFAULT_CHAT_MODEL=llama3
PRC_EMBEDDING_MODEL=nomic-embed-text
PRC_QDRANT_URL=http://localhost:6333
PRC_QDRANT_COLLECTION_PREFIX=private_research
PRC_CHUNK_SIZE=900
PRC_CHUNK_OVERLAP=160
PRC_DEFAULT_TOP_K=6
PRC_HYBRID_ALPHA=0.62
PRC_MAX_CONTEXT_CHARS=12000

